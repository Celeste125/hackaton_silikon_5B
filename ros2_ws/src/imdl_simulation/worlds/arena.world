    <model name="yellow_block">
      <static>false</static>
      <allow_auto_disable>true</allow_auto_disable>
      <pose>0.25 -0.65 0.0175 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.000006125</ixx><iyy>0.000006125</iyy><izz>0.000006125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
