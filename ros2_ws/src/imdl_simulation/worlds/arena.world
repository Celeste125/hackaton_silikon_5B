<?xml version="1.0"?>
<sdf version="1.6">
  <world name="imdl_arena">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>1.0</update_rate>
    </plugin>
    <scene><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <visual name="north_wall_visual">
          <pose>0 0.815 0.15 0 0 0</pose>
          <geometry><box><size>1.63 0.05 0.30</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
        <collision name="north_wall_collision">
          <pose>0 0.815 0.15 0 0 0</pose>
          <geometry><box><size>1.63 0.05 0.30</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -0.815 0.15 0 0 0</pose>
          <geometry><box><size>1.63 0.05 0.30</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
        <collision name="south_wall_collision">
          <pose>0 -0.815 0.15 0 0 0</pose>
          <geometry><box><size>1.63 0.05 0.30</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>0.815 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 1.63 0.30</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
        <collision name="east_wall_collision">
          <pose>0.815 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 1.63 0.30</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-0.815 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 1.63 0.30</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
        <collision name="west_wall_collision">
          <pose>-0.815 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 1.63 0.30</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>0.35 0.05 0.10 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.115</radius><length>0.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.115</radius><length>0.20</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>-0.30 -0.35 0.10 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.115</radius><length>0.20</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
