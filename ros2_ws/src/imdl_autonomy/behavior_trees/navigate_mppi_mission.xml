<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateMissionPoseRecovery">
      <PipelineSequence name="NavigateMissionPoseWithReplanning">
        <RateController hz="0.5">
          <RecoveryNode number_of_retries="1" name="ComputeMissionPosePath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearMissionGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowMissionPosePath">
          <FollowPath path="{path}" controller_id="RobustMPPI" goal_checker_id="mission_pose_goal_checker"/>
          <ClearEntireCostmap name="ClearMissionLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="MissionPoseRecoveryFallback">
        <GoalUpdated/>
        <Sequence name="MissionPoseRecoverySequence">
          <ClearEntireCostmap name="RecoveryClearMissionLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="RecoveryClearMissionGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="0.5"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
