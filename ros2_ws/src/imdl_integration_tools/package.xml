<?xml version="1.0"?>
<package format="3">
  <name>imdl_integration_tools</name>
  <version>0.1.0</version>
  <description>Hardware-free typed-object integration tools for IMDL navigation and control.</description>
  <maintainer email="todo@todo.com">IMDL Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>imdl_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
