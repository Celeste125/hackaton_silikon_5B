<?xml version="1.0"?>
<package format="3">
  <name>imdl_statemachine</name>
  <version>0.1.0</version>
  <description>Waypoint behavior tree on top of Nav2 and a saved SLAM map.</description>
  <maintainer email="lennart.troesken@tum.de">Lennart Troesken</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>imdl_autonomy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>slam</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
